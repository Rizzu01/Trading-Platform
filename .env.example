# Application
APP_NAME=Trading Platform
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_SECRET_KEY=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=CHANGE_THIS_TO_A_32_BYTE_FERNET_KEY

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trading_platform
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Logging
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# Exchange
DEFAULT_TESTNET=True
\nAI_PROVIDER=openrouter\nAI_MODEL=openai/gpt-4o-mini\nOPENROUTER_API_KEY=\nOPENAI_API_KEY=\n